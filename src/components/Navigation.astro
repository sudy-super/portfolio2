---
interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav class="navigation" id="navigation">
  <div class="nav-header">
    <a href="/" class="nav-logo" aria-label="Home">
      <img src="/sudy_logo.svg" alt="sudy" width="40" height="40" />
    </a>
  </div>

  <ul class="nav-list">
    {sections.map((section, index) => (
      <li class="nav-item">
        <a
          href={`#${section.id}`}
          class="nav-link"
          data-section={section.id}
          data-index={index}
        >
          <span class="nav-indicator"></span>
          <span class="nav-text">{section.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="nav-footer">
    <a href="mailto:hello@sudy.me" class="nav-contact">
      Contact
    </a>
  </div>
</nav>

<style>
  .navigation {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--nav-width);
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    z-index: 100;
    background: var(--color-bg);
  }

  .nav-header {
    margin-bottom: var(--space-xl);
  }

  .nav-logo {
    display: block;
    transition: transform var(--transition-base);
  }

  .nav-logo:hover {
    transform: scale(1.05);
  }

  .nav-logo img {
    width: 40px;
    height: 40px;
  }

  .nav-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .nav-item {
    opacity: 0;
    transform: translateX(-20px);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .nav-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid currentColor;
    transition: all var(--transition-fast);
  }

  .nav-link.active .nav-indicator {
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .nav-link:hover .nav-indicator {
    transform: scale(1.2);
  }

  .nav-text {
    position: relative;
  }

  .nav-link.active .nav-text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--color-text);
  }

  .nav-footer {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .nav-contact {
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    transition: color var(--transition-fast);
  }

  .nav-contact:hover {
    color: var(--color-text);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .navigation {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const initNavigation = () => {
    const navItems = document.querySelectorAll('.nav-item');
    const navLinks = document.querySelectorAll('.nav-link');
    let currentSection = 0;

    // Animate in after loading
    const showNav = () => {
      gsap.to(navItems, {
        opacity: 1,
        x: 0,
        duration: 0.4,
        stagger: 0.05,
        ease: 'power2.out',
        delay: 0.3
      });
    };

    window.addEventListener('loadingComplete', showNav);

    // If loading is already done
    if (!document.getElementById('loadingScreen') ||
        document.getElementById('loadingScreen')?.classList.contains('hidden')) {
      showNav();
    }

    // Update active state
    const setActiveSection = (index: number) => {
      currentSection = index;
      navLinks.forEach((link, i) => {
        if (i === index) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    };

    // Listen for section changes
    window.addEventListener('sectionChange', ((e: CustomEvent) => {
      setActiveSection(e.detail.index);
    }) as EventListener);

    // Click handlers
    navLinks.forEach((link, index) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('navigateTo', { detail: { index } }));
      });
    });

    // Set initial active
    setActiveSection(0);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavigation);
  } else {
    initNavigation();
  }
</script>
