---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`section-title ${className}`}>
  <span class="title-hash">#</span>
  <span class="title-text" data-text={title}></span>
  <span class="title-cursor">|</span>
</div>

<style>
  .section-title {
    display: flex;
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-xl);
  }

  .title-hash {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-text);
    margin-right: 0.05em;
  }

  .title-text {
    color: var(--color-text);
    min-width: 1ch;
  }

  .title-cursor {
    color: var(--color-text);
    animation: blink 0.8s step-end infinite;
    margin-left: 0.02em;
    font-weight: 300;
  }

  .title-cursor.hidden {
    opacity: 0;
    animation: none;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .section-title {
      font-size: clamp(2rem, 12vw, 4rem);
    }

    .title-hash {
      -webkit-text-stroke-width: 1.5px;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  // Typewriter animation function
  export const typewriterAnimate = (
    element: HTMLElement,
    text: string,
    options: { speed?: number; onComplete?: () => void } = {}
  ) => {
    const { speed = 50, onComplete } = options;
    const textEl = element.querySelector('.title-text') as HTMLElement;
    const cursorEl = element.querySelector('.title-cursor') as HTMLElement;

    if (!textEl) return;

    // Show cursor
    cursorEl?.classList.remove('hidden');

    // Clear existing text
    textEl.textContent = '';

    // Type each character
    let charIndex = 0;
    const typeChar = () => {
      if (charIndex < text.length) {
        textEl.textContent += text[charIndex];
        charIndex++;
        setTimeout(typeChar, speed);
      } else {
        // Hide cursor after typing completes
        setTimeout(() => {
          cursorEl?.classList.add('hidden');
          onComplete?.();
        }, 500);
      }
    };

    typeChar();
  };

  // Reverse typewriter (delete text)
  export const typewriterDelete = (
    element: HTMLElement,
    options: { speed?: number; onComplete?: () => void } = {}
  ) => {
    const { speed = 30, onComplete } = options;
    const textEl = element.querySelector('.title-text') as HTMLElement;
    const cursorEl = element.querySelector('.title-cursor') as HTMLElement;

    if (!textEl) return;

    // Show cursor
    cursorEl?.classList.remove('hidden');

    const deleteChar = () => {
      const currentText = textEl.textContent || '';
      if (currentText.length > 0) {
        textEl.textContent = currentText.slice(0, -1);
        setTimeout(deleteChar, speed);
      } else {
        onComplete?.();
      }
    };

    deleteChar();
  };

  // Initialize section titles
  const initSectionTitles = () => {
    const titles = document.querySelectorAll('.section-title');

    titles.forEach((title) => {
      const textEl = title.querySelector('.title-text') as HTMLElement;
      const cursorEl = title.querySelector('.title-cursor') as HTMLElement;

      if (textEl && textEl.dataset.text) {
        // Initially hide cursor
        cursorEl?.classList.add('hidden');
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSectionTitles);
  } else {
    initSectionTitles();
  }
</script>
