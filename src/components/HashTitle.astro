---
// Fixed hash title component - # stays fixed, text changes with typewriter effect
---

<div class="hash-title hidden" id="hashTitle">
  <span class="hash-symbol">#</span>
  <span class="title-text" id="titleText"></span>
  <span class="title-cursor hidden" id="titleCursor">|</span>
</div>

<style>
  .hash-title {
    position: fixed;
    top: var(--space-lg);
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: baseline;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    /* section-contentと同じ位置に揃える（中央揃えを考慮） */
    padding-left: max(var(--space-xl), calc((100vw - 784px) / 2));
    padding-right: var(--space-xl);
  }

  .hash-title.hidden {
    opacity: 0;
    transform: translateY(-20px);
  }

  .hash-symbol {
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-right: 0.05em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hash-symbol.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .title-text {
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .title-cursor {
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 300;
    color: var(--color-text);
    margin-left: 0.05em;
    animation: blink 1s infinite;
  }

  .title-cursor.hidden {
    opacity: 0;
    animation: none;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hash-title {
      top: 10%;
      padding-left: var(--space-lg);
      padding-right: var(--space-lg);
    }
  }
</style>
