---
const internships = [
  {
    company: 'PKSHA Technology Inc.',
    role: 'Research Intern',
    period: 'September 2025 - Present',
    url: 'https://pkshatech.com'
  },
  {
    company: 'Turing Inc.',
    role: 'Research Intern',
    period: 'August 2025 - September 2025',
    url: 'https://tur.ing/'
  },
  {
    company: 'ReAlice Inc.',
    role: 'Machine Learning Engineer',
    period: 'August 2023 - January 2024',
    url: 'https://realice.jp/'
  },
  {
    company: 'Pictoria Inc.',
    role: 'Backend Engineer',
    period: 'July 2023 - September 2023',
    url: 'https://www.pictoria.co.jp/'
  },
];
---

<section class="section intern-section" id="intern" data-section="intern">
  <div class="section-content">
    <div class="intern-list">
      {internships.map((intern, index) => (
        <a href={intern.url} target="_blank" rel="noopener noreferrer" class="intern-item parallax-layer" data-depth={(index + 1) * 0.02}>
          <div class="intern-main">
            <h3 class="intern-company">{intern.company}</h3>
            <p class="intern-role">{intern.role}</p>
          </div>
          <div class="intern-meta">
            <span class="intern-period">{intern.period}</span>
            <span class="intern-link-icon">↗</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .intern-section {
    display: flex;
    align-items: center;
  }

  .intern-list {
    display: flex;
    flex-direction: column;
  }

  .intern-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(20px);
    transition: background var(--transition-fast);
  }

  .intern-item:hover {
    background: rgba(0, 0, 0, 0.02);
  }

  .intern-main {
    flex: 1;
  }

  .intern-company {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-xs);
  }

  .intern-role {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .intern-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-xs);
  }

  .intern-period {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    text-align: right;
  }

  .intern-link-icon {
    font-size: 1rem;
    color: var(--color-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .intern-item:hover .intern-link-icon {
    transform: translate(2px, -2px);
    color: var(--color-text);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .intern-item {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .intern-meta {
      align-items: flex-start;
    }
  }
</style>
