---
---

<section class="section hero-section" id="hero" data-section="hero">
  <div class="hero-content">
    <div class="hero-title" id="heroTitle">
      <span class="hash-symbol">#</span>
      <span class="title-text" id="heroTitleText"></span>
      <span class="title-cursor hidden" id="heroTitleCursor">|</span>
    </div>
  </div>
  <div class="scroll-indicator parallax-layer" data-depth="0.02">
    <div class="scroll-arrow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .hero-content {
    text-align: center;
  }

  .hero-title {
    display: flex;
    align-items: baseline;
    justify-content: center;
  }

  .hash-symbol {
    font-size: clamp(5rem, 15vw, 12rem);
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-right: 0.05em;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hash-symbol.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .title-text {
    font-size: clamp(5rem, 15vw, 12rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .title-cursor {
    font-size: clamp(5rem, 15vw, 12rem);
    font-weight: 300;
    color: var(--color-text);
    margin-left: 0.05em;
    animation: blink 1s infinite;
  }

  .title-cursor.hidden {
    opacity: 0;
    animation: none;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
  }

  .scroll-arrow {
    color: var(--color-muted);
    animation: scrollBounce 2s ease-in-out infinite;
  }

  .scroll-arrow svg {
    width: 24px;
    height: 24px;
  }

  @keyframes scrollBounce {
    0%, 100% {
      opacity: 0.5;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(8px);
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      bottom: var(--space-lg);
    }
  }
</style>
