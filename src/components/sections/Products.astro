---
const products = [
  { name: 'Malum-230', year: '2025', desc: '高品質な論理推論データセット' },
  { name: 'Sentinel', year: '2023', desc: '多言語プロンプトインジェクション判定器' },
  { name: 'AutoMATA', year: '2023', desc: 'LLM能動的推論ツール' },
  { name: 'Baku', year: '2024', desc: 'CALM2-7b拡張モデル' },
];
---

<section class="section products-section" id="products" data-section="products">
  <div class="section-content">
    <div class="products-list">
      {products.map((product, index) => (
        <div class="product-item parallax-layer" data-depth={(index + 1) * 0.02}>
          <span class="product-year">{product.year}</span>
          <div class="product-info">
            <h3 class="product-name">{product.name}</h3>
            <p class="product-desc">{product.desc}</p>
          </div>
          <span class="product-arrow">→</span>
        </div>
      ))}
    </div>

    <a href="/products" class="view-all-link parallax-layer" data-depth="0.06">
      <span>View All Products</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .products-section {
    display: flex;
    align-items: center;
  }

  .products-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .product-item {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(20px);
    transition: background var(--transition-fast);
  }

  .product-item:hover {
    background: rgba(0, 0, 0, 0.02);
  }

  .product-year {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    min-width: 50px;
  }

  .product-info {
    flex: 1;
  }

  .product-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-xs);
  }

  .product-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .product-arrow {
    font-size: 1.25rem;
    color: var(--color-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .product-item:hover .product-arrow {
    transform: translateX(4px);
    color: var(--color-text);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-text);
    transition: gap var(--transition-fast);
    opacity: 0;
    transform: translateY(20px);
  }

  .view-all-link:hover {
    gap: var(--space-md);
  }

  .view-all-link svg {
    width: 16px;
    height: 16px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .product-item {
      flex-wrap: wrap;
    }

    .product-year {
      width: 100%;
      margin-bottom: var(--space-xs);
    }
  }
</style>
