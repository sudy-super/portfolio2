---
const career = [
  { period: '2025-04 ~', title: '筑波大学 情報学群 情報科学類' },
  { period: '2022-04 ~ 2025-03', title: '早稲田高等学校' },
];

const achievements = [
  { year: '2024', title: '未踏ジュニア2024 採択', grade: '高3' },
  { year: '2023', title: 'LOCAL AI HACKATHON #000 銅賞', grade: '高2' },
  { year: '2022', title: '缶サット甲子園 2022 全国大会出場', grade: '高1' },
];
---

<section class="section career-section" id="career" data-section="career">
  <div class="section-content">
    <div class="career-grid">
      <div class="career-education parallax-layer" data-depth="0.05">
        <h3 class="subsection-label">Education</h3>
        <ul class="education-list">
          {career.map((item) => (
            <li class="education-item">
              <span class="education-period">{item.period}</span>
              <span class="education-title">{item.title}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="career-achievements parallax-layer" data-depth="0.08">
        <h3 class="subsection-label">Achievements</h3>
        <ul class="achievements-list">
          {achievements.map((item) => (
            <li class="achievement-item">
              <div class="achievement-meta">
                <span class="achievement-year">{item.year}</span>
                <span class="achievement-grade">{item.grade}</span>
              </div>
              <span class="achievement-title">{item.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .career-section {
    display: flex;
    align-items: center;
  }

  .career-grid {
    display: grid;
    gap: var(--space-xl);
  }

  .career-education,
  .career-achievements {
    opacity: 0;
    transform: translateY(30px);
  }

  .subsection-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
  }

  .education-list,
  .achievements-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .education-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .education-period {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  .education-title {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .achievement-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .achievement-meta {
    display: flex;
    flex-direction: column;
    min-width: 60px;
  }

  .achievement-year {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .achievement-grade {
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .achievement-title {
    font-size: 1rem;
    font-weight: 500;
    flex: 1;
  }

</style>
