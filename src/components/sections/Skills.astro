---
const languages = ['Python', 'C++'];
const tools = ['PyTorch', 'Docker', 'Azure'];
const experiences = [
  'LLMの事前学習、Fine-tuning、プロンプトエンジニアリング、RAGの開発',
  'LLMの事前学習・Fine-tuning向けデータセットの構築、収集',
  'C++を用いた200b tokens規模の高品質テキストコーパスの構築',
  'GPUノード間の通信最適化',
  'LLMの分散学習（Megatron-LM, gpt-neox等）',
  'PyTorchを用いたオリジナルアーキテクチャモデルの構築',
];
---

<section class="section skills-section" id="skills" data-section="skills">
  <div class="section-content">
    <div class="skills-grid">
      <div class="skills-group parallax-layer" data-depth="0.04">
        <h3 class="skills-label">Languages</h3>
        <div class="skills-tags">
          {languages.map((lang) => (
            <span class="skill-tag">{lang}</span>
          ))}
        </div>
      </div>

      <div class="skills-group parallax-layer" data-depth="0.06">
        <h3 class="skills-label">Tools</h3>
        <div class="skills-tags">
          {tools.map((tool) => (
            <span class="skill-tag">{tool}</span>
          ))}
        </div>
      </div>

      <div class="skills-experience parallax-layer" data-depth="0.08">
        <h3 class="skills-label">Experience</h3>
        <ul class="experience-list">
          {experiences.map((exp) => (
            <li class="experience-item">{exp}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-section {
    display: flex;
    align-items: center;
  }

  .skills-grid {
    display: grid;
    gap: var(--space-xl);
  }

  .skills-group,
  .skills-experience {
    opacity: 0;
    transform: translateY(30px);
  }

  .skills-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
  }

  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .skill-tag:hover {
    background: var(--color-text);
    color: var(--color-white);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .experience-item {
    position: relative;
    padding-left: var(--space-md);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .experience-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-muted);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .experience-item {
      font-size: 0.875rem;
    }
  }
</style>
