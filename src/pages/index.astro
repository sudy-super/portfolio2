---
import Layout from '../layouts/Layout.astro';
import Loading from '../components/Loading.astro';
import HashTitle from '../components/HashTitle.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Products from '../components/sections/Products.astro';
import Career from '../components/sections/Career.astro';
import Skills from '../components/sections/Skills.astro';
import Intern from '../components/sections/Intern.astro';
import Blog from '../components/sections/Blog.astro';
import Contact from '../components/sections/Contact.astro';

---

<Layout title="sudy - Portfolio">
  <Loading />
  <HashTitle />
  <Sidebar />

  <main class="main-container" id="mainContainer">
    <div class="sections-wrapper" id="sectionsWrapper">
      <Hero />
      <About />
      <Products />
      <Career />
      <Skills />
      <Intern />
      <Blog />
      <Contact />
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .main-container {
    height: 100vh;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
  }

  .sections-wrapper {
    display: flex;
    flex-direction: column;
  }

  .sections-wrapper :global(.section) {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Footer snap point */
  .main-container :global(.footer) {
    scroll-snap-align: start;
  }

  /* Hide scrollbar but keep functionality */
  .main-container::-webkit-scrollbar {
    width: 0;
  }

  .main-container {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
</style>

<script>
  import gsap from 'gsap';

  const initFullPageScroll = () => {
    const mainContainer = document.getElementById('mainContainer');
    const sections = document.querySelectorAll('.section');

    // HashTitle elements (left-top, for non-Hero sections)
    const hashTitle = document.getElementById('hashTitle');
    const hashTitleSymbol = hashTitle?.querySelector('.hash-symbol');
    const titleText = document.getElementById('titleText');
    const titleCursor = document.getElementById('titleCursor');

    // Hero title elements (center)
    const heroTitle = document.getElementById('heroTitle');
    const heroHashSymbol = heroTitle?.querySelector('.hash-symbol');
    const heroTitleText = document.getElementById('heroTitleText');
    const heroTitleCursor = document.getElementById('heroTitleCursor');

    let currentSection = -1; // Start at -1 to show "sudy" initially
    let isAnimating = false;
    let lastScrollTime = 0;
    const scrollCooldown = 800;

    // Section titles data - matches section order (Hero shows sudy, then section names)
    const sectionNames = ['sudy', 'About', 'Products', 'Career', 'Skills', 'Intern', 'Blog', 'Contact'];

    // Typewriter animation for HashTitle (left-top)
    const typewriterAnimate = (text: string, callback?: () => void) => {
      if (!titleText || !titleCursor) return;

      titleCursor.classList.remove('hidden');
      titleText.textContent = '';

      let charIndex = 0;
      const typeChar = () => {
        if (charIndex < text.length) {
          titleText.textContent += text[charIndex];
          charIndex++;
          setTimeout(typeChar, 50);
        } else {
          setTimeout(() => {
            titleCursor.classList.add('hidden');
            callback?.();
          }, 500);
        }
      };

      typeChar();
    };

    // Typewriter animation for Hero (center)
    const heroTypewriterAnimate = (text: string, callback?: () => void) => {
      if (!heroTitleText || !heroTitleCursor) return;

      heroTitleCursor.classList.remove('hidden');
      heroTitleText.textContent = '';

      let charIndex = 0;
      const typeChar = () => {
        if (charIndex < text.length) {
          heroTitleText.textContent += text[charIndex];
          charIndex++;
          setTimeout(typeChar, 50);
        } else {
          setTimeout(() => {
            heroTitleCursor.classList.add('hidden');
            callback?.();
          }, 500);
        }
      };

      typeChar();
    };

    // Animate section content
    const animateSectionContent = (sectionIndex: number) => {
      if (sectionIndex < 0 || sectionIndex >= sections.length) return;

      const section = sections[sectionIndex];
      const parallaxLayers = section.querySelectorAll('.parallax-layer');

      // Hero uses center typewriter, others use HashTitle
      if (sectionIndex === 0) {
        hashTitle?.classList.add('hidden');
        hashTitleSymbol?.classList.remove('visible'); // Reset for next section
        // Show # first, then start typewriter
        heroHashSymbol?.classList.add('visible');
        setTimeout(() => {
          heroTypewriterAnimate(sectionNames[sectionIndex]);
        }, 400);
      } else {
        heroHashSymbol?.classList.remove('visible'); // Reset hero # when leaving
        hashTitle?.classList.remove('hidden');
        // Show # first, then start typewriter
        hashTitleSymbol?.classList.add('visible');
        setTimeout(() => {
          typewriterAnimate(sectionNames[sectionIndex]);
        }, 400);
      }

      // Animate content with stagger
      gsap.fromTo(parallaxLayers,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: 'power2.out',
          delay: 0.3
        }
      );
    };

    // Navigate to section
    const navigateToSection = (index: number) => {
      if (isAnimating || index === currentSection || index < 0 || index >= sections.length) return;

      isAnimating = true;
      const targetSection = sections[index];

      // Scroll to section
      targetSection.scrollIntoView({ behavior: 'smooth' });

      // Update current section
      currentSection = index;

      // Dispatch event for navigation
      window.dispatchEvent(new CustomEvent('sectionChange', { detail: { index } }));

      // Animate content
      setTimeout(() => {
        animateSectionContent(index);
      }, 300);

      // Reset animation lock
      setTimeout(() => {
        isAnimating = false;
      }, scrollCooldown);
    };

    // Handle scroll - find section with hysteresis to prevent flickering
    const findVisibleSection = (): number => {
      const viewportHeight = window.innerHeight;

      // Check if current section is still mostly visible (hysteresis)
      if (currentSection >= 0 && currentSection < sections.length) {
        const currentRect = sections[currentSection].getBoundingClientRect();
        const visibleTop = Math.max(0, currentRect.top);
        const visibleBottom = Math.min(viewportHeight, currentRect.bottom);
        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
        const visibleRatio = visibleHeight / viewportHeight;

        // Keep current section if more than 40% is visible
        if (visibleRatio > 0.4) {
          return currentSection;
        }
      }

      // Find section whose top is closest to viewport top
      let bestSection = 0;
      let bestDistance = Infinity;

      sections.forEach((section, index) => {
        const rect = section.getBoundingClientRect();
        const distance = Math.abs(rect.top);

        if (distance < bestDistance) {
          bestDistance = distance;
          bestSection = index;
        }
      });

      return bestSection;
    };

    let wasInFooter = false;

    const handleScroll = () => {
      const scrollTop = mainContainer?.scrollTop || 0;
      const sectionHeight = window.innerHeight;

      // Hide HashTitle on Hero (index 0) and in footer area
      const totalSectionsHeight = sections.length * sectionHeight;
      const isOnHero = scrollTop < sectionHeight / 2;
      const isInFooter = scrollTop > totalSectionsHeight - sectionHeight / 2;

      if (isOnHero || isInFooter) {
        hashTitle?.classList.add('hidden');
        // Clear text content so next section starts fresh with typewriter
        if (titleText) titleText.textContent = '';
        hashTitleSymbol?.classList.remove('visible');
        wasInFooter = isInFooter;
      } else {
        hashTitle?.classList.remove('hidden');
        // Re-animate when returning from footer
        if (wasInFooter && currentSection > 0) {
          animateSectionContent(currentSection);
          wasInFooter = false;
        }
      }

      // Early return for section change logic
      if (isAnimating) return;

      const newSection = findVisibleSection();

      if (newSection !== currentSection && newSection >= 0 && newSection < sections.length) {
        currentSection = newSection;

        // Dispatch event
        window.dispatchEvent(new CustomEvent('sectionChange', { detail: { index: currentSection } }));

        // Animate content
        animateSectionContent(currentSection);
      }
    };

    // Listen for scroll
    mainContainer?.addEventListener('scroll', handleScroll, { passive: true });

    // Listen for navigation clicks
    window.addEventListener('navigateTo', ((e: CustomEvent) => {
      navigateToSection(e.detail.index);
    }) as EventListener);

    // Parallax effect on mouse move
    const initParallax = () => {
      document.addEventListener('mousemove', (e) => {
        const x = (e.clientX / window.innerWidth - 0.5) * 2;
        const y = (e.clientY / window.innerHeight - 0.5) * 2;

        if (currentSection < 0 || currentSection >= sections.length) return;

        const currentSectionEl = sections[currentSection];
        const layers = currentSectionEl?.querySelectorAll('.parallax-layer');

        layers?.forEach((layer) => {
          const depth = parseFloat((layer as HTMLElement).dataset.depth || '0.05');
          gsap.to(layer, {
            x: x * 30 * depth,
            y: y * 30 * depth,
            duration: 0.5,
            ease: 'power2.out'
          });
        });
      });
    };

    // Initialize after loading
    const init = () => {
      // Initial animation for first section after a short delay
      setTimeout(() => {
        currentSection = 0;
        animateSectionContent(0);
        initParallax();

        // Dispatch initial section change
        window.dispatchEvent(new CustomEvent('sectionChange', { detail: { index: 0 } }));
      }, 500);
    };

    // Wait for loading to complete
    window.addEventListener('loadingComplete', init);

    // If loading is already done
    if (!document.getElementById('loadingScreen') ||
        document.getElementById('loadingScreen')?.classList.contains('hidden')) {
      init();
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'PageDown') {
        e.preventDefault();
        navigateToSection(currentSection + 1);
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault();
        navigateToSection(currentSection - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        navigateToSection(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        navigateToSection(sections.length - 1);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFullPageScroll);
  } else {
    initFullPageScroll();
  }
</script>
