---
import Layout from '../layouts/Layout.astro';
import HashTitle from '../components/HashTitle.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Career from '../components/sections/Career.astro';
import Blog from '../components/sections/Blog.astro';
import Link from '../components/sections/Link.astro';
import Contact from '../components/sections/Contact.astro';

---

<Layout title="sudy - Portfolio">
  <HashTitle />
  <Sidebar />

  <main class="main-container" id="mainContainer">
    <div class="sections-wrapper" id="sectionsWrapper">
      <Hero />
      <About />
      <Career />
      <Blog />
      <Link />
      <Contact />
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .main-container {
    height: 100vh;
    overflow-y: auto;
    scroll-behavior: smooth;
  }

  .sections-wrapper {
    display: flex;
    flex-direction: column;
  }

  /* Hide scrollbar but keep functionality */
  .main-container::-webkit-scrollbar {
    width: 0;
  }

  .main-container {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
</style>

<script>
  import gsap from 'gsap';

  const initFullPageScroll = () => {
    const mainContainer = document.getElementById('mainContainer');
    const sections = document.querySelectorAll('.section');

    // HashTitle elements (left-top, for non-Hero sections)
    const hashTitle = document.getElementById('hashTitle');
    const hashTitleSymbol = hashTitle?.querySelector('.hash-symbol');
    const titleText = document.getElementById('titleText');
    const titleCursor = document.getElementById('titleCursor');

    // Hero title elements (center)
    const heroTitle = document.getElementById('heroTitle');
    const heroHashSymbol = heroTitle?.querySelector('.hash-symbol');
    const heroTitleText = document.getElementById('heroTitleText');
    const heroTitleCursor = document.getElementById('heroTitleCursor');

    let currentSection = -1; // Start at -1 to show "sudy" initially
    let isAnimating = false;
    const scrollCooldown = 800;

    // Section titles data - matches section order (Hero shows sudy, then section names)
    const sectionNames = ['sudy', 'About', 'Career', 'Blog', 'Link', 'Contact'];

    // Title state: token cancels in-flight timeouts so concurrent typewriters can't mix characters
    let titleSection = -2;
    let titleAnimToken = 0;
    let titleAnimTimeouts: ReturnType<typeof setTimeout>[] = [];

    const clearTitleAnim = () => {
      titleAnimToken++;
      titleAnimTimeouts.forEach(clearTimeout);
      titleAnimTimeouts = [];
    };

    const scheduleAnim = (fn: () => void, ms: number, token: number) => {
      const id = setTimeout(() => {
        if (token !== titleAnimToken) return;
        titleAnimTimeouts = titleAnimTimeouts.filter(t => t !== id);
        fn();
      }, ms);
      titleAnimTimeouts.push(id);
    };

    const typewriter = (target: HTMLElement, cursor: HTMLElement, text: string, token: number) => {
      if (token !== titleAnimToken) return;
      cursor.classList.remove('hidden');
      target.textContent = '';
      let i = 0;
      const step = () => {
        if (token !== titleAnimToken) return;
        if (i < text.length) {
          target.textContent += text[i++];
          scheduleAnim(step, 50, token);
        } else {
          scheduleAnim(() => cursor.classList.add('hidden'), 500, token);
        }
      };
      step();
    };

    const renderTitle = (sectionIndex: number) => {
      clearTitleAnim();
      const token = titleAnimToken;

      // Reset every title surface so a stale typewriter result can't bleed through
      if (titleText) titleText.textContent = '';
      if (titleCursor) titleCursor.classList.add('hidden');
      if (heroTitleText) heroTitleText.textContent = '';
      if (heroTitleCursor) heroTitleCursor.classList.add('hidden');

      if (sectionIndex < 0 || sectionIndex >= sectionNames.length) {
        hashTitle?.classList.add('hidden');
        hashTitleSymbol?.classList.remove('visible');
        heroHashSymbol?.classList.remove('visible');
        return;
      }

      const name = sectionNames[sectionIndex];

      if (sectionIndex === 0) {
        hashTitle?.classList.add('hidden');
        hashTitleSymbol?.classList.remove('visible');
        heroHashSymbol?.classList.add('visible');
        scheduleAnim(() => {
          if (heroTitleText && heroTitleCursor) typewriter(heroTitleText, heroTitleCursor, name, token);
        }, 400, token);
      } else {
        heroHashSymbol?.classList.remove('visible');
        hashTitle?.classList.remove('hidden');
        hashTitleSymbol?.classList.add('visible');
        scheduleAnim(() => {
          if (titleText && titleCursor) typewriter(titleText as HTMLElement, titleCursor as HTMLElement, name, token);
        }, 400, token);
      }
    };

    // Token-based cancellation alone keeps rapid swaps from mixing characters
    const requestTitle = (sectionIndex: number) => {
      if (sectionIndex === titleSection) return;
      titleSection = sectionIndex;
      hashTitle?.style.setProperty('--title-fade', '1');
      renderTitle(sectionIndex);
    };

    // Animate parallax content for a section (title is handled separately via requestTitle)
    const animateSectionContent = (sectionIndex: number) => {
      if (sectionIndex < 0 || sectionIndex >= sections.length) return;

      requestTitle(sectionIndex);

      const section = sections[sectionIndex];
      const parallaxLayers = section.querySelectorAll('.parallax-layer');

      gsap.fromTo(parallaxLayers,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: 'power2.out',
          delay: 0.3
        }
      );
    };

    // Navigate to section
    const navigateToSection = (index: number) => {
      if (isAnimating || index === currentSection || index < 0 || index >= sections.length) return;

      isAnimating = true;
      const targetSection = sections[index];

      targetSection.scrollIntoView({ behavior: 'smooth' });

      currentSection = index;
      window.dispatchEvent(new CustomEvent('sectionChange', { detail: { index } }));

      requestTitle(index);

      setTimeout(() => {
        const section = sections[index];
        const parallaxLayers = section.querySelectorAll('.parallax-layer');
        gsap.fromTo(parallaxLayers,
          { opacity: 0, y: 30 },
          { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power2.out', delay: 0.3 }
        );
      }, 300);

      setTimeout(() => {
        isAnimating = false;
      }, scrollCooldown);
    };

    // Handle scroll - find section with hysteresis to prevent flickering
    const findVisibleSection = (): number => {
      const viewportHeight = window.innerHeight;

      // Check if current section is still mostly visible (hysteresis)
      if (currentSection >= 0 && currentSection < sections.length) {
        const currentRect = sections[currentSection].getBoundingClientRect();
        const visibleTop = Math.max(0, currentRect.top);
        const visibleBottom = Math.min(viewportHeight, currentRect.bottom);
        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
        const visibleRatio = visibleHeight / viewportHeight;

        // Keep current section if more than 40% is visible
        if (visibleRatio > 0.4) {
          return currentSection;
        }
      }

      // Find section whose top is closest to viewport top
      let bestSection = 0;
      let bestDistance = Infinity;

      sections.forEach((section, index) => {
        const rect = section.getBoundingClientRect();
        const distance = Math.abs(rect.top);

        if (distance < bestDistance) {
          bestDistance = distance;
          bestSection = index;
        }
      });

      return bestSection;
    };

    // Fade hashTitle out when section content has scrolled up far enough to collide with it
    const TITLE_FADE_START = 80;
    const TITLE_FADE_END = 220;
    const updateTitleFade = () => {
      if (!hashTitle) return;
      if (currentSection < 1 || currentSection >= sections.length) {
        hashTitle.style.setProperty('--title-fade', '1');
        return;
      }
      const rect = sections[currentSection].getBoundingClientRect();
      const overscroll = Math.max(0, -rect.top);
      const t = Math.max(0, Math.min(1, (overscroll - TITLE_FADE_START) / (TITLE_FADE_END - TITLE_FADE_START)));
      hashTitle.style.setProperty('--title-fade', String(1 - t));
    };

    const handleScroll = () => {
      const scrollTop = mainContainer?.scrollTop || 0;
      const sectionHeight = window.innerHeight;
      const totalSectionsHeight = sections.length * sectionHeight;
      const isInFooter = scrollTop > totalSectionsHeight - sectionHeight / 2;

      if (isInFooter) {
        requestTitle(-1);
        return;
      }

      if (!isAnimating) {
        const newSection = findVisibleSection();
        if (newSection >= 0 && newSection < sections.length) {
          if (newSection !== currentSection) {
            currentSection = newSection;
            window.dispatchEvent(new CustomEvent('sectionChange', { detail: { index: currentSection } }));
            animateSectionContent(currentSection);
          } else if (titleSection !== currentSection) {
            requestTitle(currentSection);
          }
        }
      }

      updateTitleFade();
    };

    // Listen for scroll
    mainContainer?.addEventListener('scroll', handleScroll, { passive: true });

    // Listen for navigation clicks
    window.addEventListener('navigateTo', ((e: CustomEvent) => {
      navigateToSection(e.detail.index);
    }) as EventListener);

    // Parallax effect on mouse move
    const initParallax = () => {
      document.addEventListener('mousemove', (e) => {
        const x = (e.clientX / window.innerWidth - 0.5) * 2;
        const y = (e.clientY / window.innerHeight - 0.5) * 2;

        if (currentSection < 0 || currentSection >= sections.length) return;

        const currentSectionEl = sections[currentSection];
        const layers = currentSectionEl?.querySelectorAll('.parallax-layer');

        layers?.forEach((layer) => {
          const depth = parseFloat((layer as HTMLElement).dataset.depth || '0.05');
          gsap.to(layer, {
            x: x * 30 * depth,
            y: y * 30 * depth,
            duration: 0.5,
            ease: 'power2.out'
          });
        });
      });
    };

    // Initialize after loading
    const init = () => {
      setTimeout(() => {
        currentSection = 0;
        requestTitle(0);
        const section = sections[0];
        const parallaxLayers = section.querySelectorAll('.parallax-layer');
        gsap.fromTo(parallaxLayers,
          { opacity: 0, y: 30 },
          { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power2.out', delay: 0.3 }
        );
        initParallax();
        window.dispatchEvent(new CustomEvent('sectionChange', { detail: { index: 0 } }));
      }, 500);
    };

    init();

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'PageDown') {
        e.preventDefault();
        navigateToSection(currentSection + 1);
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault();
        navigateToSection(currentSection - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        navigateToSection(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        navigateToSection(sections.length - 1);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFullPageScroll);
  } else {
    initFullPageScroll();
  }
</script>
