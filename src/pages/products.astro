---
import Layout from '../layouts/Layout.astro';
import { Scene } from '../components/r3f/Scene';
import { works } from '../data/works';
---

<Layout title="Products - sudy" description="sudy's projects and products">
  <div class="gallery-container">
    <Scene client:only="react" works={works} />
  </div>
</Layout>

<style>
  .gallery-container {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }
</style>
